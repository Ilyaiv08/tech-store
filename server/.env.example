# ===========================================
# Tech Store Server Configuration
# ===========================================

# Порт сервера (по умолчанию 5000)
PORT=5000

# ===========================================
# JWT Settings
# ===========================================
# Секретный ключ для JWT токенов
# ВАЖНО: Измените это значение в продакшене!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Время жизни токена (7 дней)
JWT_EXPIRES_IN=7d

# ===========================================
# Admin User Settings
# ===========================================
# Данные для создания администратора
# Используйте команду: npm run create-admin

# Email администратора (обязательно)
ADMIN_EMAIL=admin@techstore.com

# Пароль администратора (обязательно, мин. 6 символов)
ADMIN_PASSWORD=admin123

# Имя администратора (необязательно, по умолчанию "Admin")
ADMIN_NAME=Admin
